DATABASE_URL=postgresql://user:password@localhost:5432/gruene_aktionen
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://aktionen.gruene-mitte.de
AUTH_TRUST_HOST=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=aktionen@gruene-mitte.de
EMAIL_FROM_NAME="Kreisvorstand B90/GRÜNE Berlin-Mitte"
# min. 32 Zeichen, z.B. openssl rand -hex 32 – sonst sind die Cron-Endpunkte gesperrt
CRON_SECRET=your-cron-secret-here

# Grundeinrichtung einer neuen Datenbank (npm run db:bootstrap bzw.
# im Container: node dist/bootstrap.js). Danach wieder entfernen.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_PASSWORD=mindestens-12-zeichen
# BOOTSTRAP_ADMIN_NAME="Vorname Nachname"

# ── Kreisverbands-Konfiguration ──────────────────────────────────────
# Alle Werte sind optional. Defaults: BÜNDNIS 90/DIE GRÜNEN Berlin-Mitte.
# Für andere Kreisverbände die passenden Werte setzen.

# Organisation
# Kopfzeilen zeigen den vollen Namen und wechseln auf schmalen Bildschirmen zum Kurznamen.
# Der Kurzname steht außerdem im Browser-Tab und in E-Mail-Betreffs.
NEXT_PUBLIC_ORG_SHORT_NAME="B90/GRÜNE Berlin-Mitte"
NEXT_PUBLIC_ORG_FULL_NAME="BÜNDNIS 90/DIE GRÜNEN Berlin-Mitte"
ORG_LEGAL_NAME="BÜNDNIS 90/DIE GRÜNEN Kreisverband Berlin-Mitte"
ORG_RESPONSIBLE="Kreisvorstand BÜNDNIS 90/DIE GRÜNEN Berlin-Mitte"
ORG_SUBTITLE="Kreisvorstand"
ORG_TEAM_NAMES="Annalena, Florian, Lara, Linus, Madlen und Timur"

# Kontakt
CONTACT_EMAIL=info@gruene-mitte.de
WEBSITE_URL=www.gruene-mitte.de
IMPRESSUM_URL=https://gruene-mitte.de/impressum

# Adresse
ADDRESS_STREET="Tegeler Straße 31"
ADDRESS_POSTAL_CODE=13353
ADDRESS_CITY=Berlin

# Karte & Geocoding
# Stadt, die beim Geocoding an Aktions-Adressen angehängt wird (Default: ADDRESS_CITY)
# GEOCODING_CITY=Berlin
# Startansicht der Karte als "Breitengrad,Längengrad" (Default: Berlin-Mitte).
# NEXT_PUBLIC_*-Werte werden beim Build eingebettet – nach Änderung neu bauen.
# NEXT_PUBLIC_MAP_CENTER="52.5235,13.4115"
# NEXT_PUBLIC_MAP_ZOOM=13
# Kachelserver der Karte (Default: tile.openstreetmap.de von FOSSGIS e.V., Server
# in der EU). Nur https; der Host wird automatisch in die CSP übernommen. Bei einem
# anderen Anbieter auch die Quellenangabe (HTML, Pflicht laut Anbieter) und
# MAP_TILE_PROVIDER / MAP_TILE_PROVIDER_PRIVACY_URL für die Datenschutzerklärung
# anpassen und prüfen, ob der Abschnitt "Übermittlung in Drittländer" noch stimmt.
# Beispiel basemap.de (BKG, nur Deutschland):
# NEXT_PUBLIC_MAP_TILE_URL="https://sgx.geodatenzentrum.de/wmts_basemapde/tile/1.0.0/de_basemapde_web_raster_farbe/default/GLOBAL_WEBMERCATOR/{z}/{y}/{x}.png"
# NEXT_PUBLIC_MAP_ATTRIBUTION='© <a href="https://basemap.de">basemap.de</a> / BKG (CC BY 4.0)'
# MAP_TILE_PROVIDER="Bundesamt für Kartographie und Geodäsie (BKG), Frankfurt am Main"
# MAP_TILE_PROVIDER_PRIVACY_URL="https://www.bkg.bund.de/datenschutz"

# Visuelles Theme (Default: brutalist). "emerald" = Design der Leipziger
# OBM-Kampagne 2027. Wird beim Build eingebettet – nach Änderung neu bauen.
# NEXT_PUBLIC_THEME=emerald

# Texte im Kampagnen-Kopfbereich der Startseite (nur im Theme "emerald"; das
# Foto gehört zum Theme). Wird beim Build eingebettet – nach Änderung neu bauen.
# NEXT_PUBLIC_HERO_TITLE="Mach mit im Wahlkampf!"
# NEXT_PUBLIC_HERO_TEXT="Ob Infostand, Haustür oder Plakatieren: Jede helfende Hand zählt. Wir freuen uns auf dich!"

# Datenschutzbeauftragte*r
DSB_NAME="SCO-CON:SULT"
DSB_STREET="Hauptstraße 27"
DSB_POSTAL_CODE=53604
DSB_CITY="Bad Honnef"
DSB_EMAIL=datenschutz@gruene-berlin.de
DSB_PHONE="02224/988290"
# Kontaktformular statt E-Mail/Telefon (optional). Ist es gesetzt, dürfen
# DSB_EMAIL und DSB_PHONE fehlen und werden dann nicht angezeigt.
# DSB_CONTACT_URL=https://example.org/datenschutz/kontakt/

# Aufsichtsbehörde
AUFSICHT_NAME="Berliner Beauftragte für Datenschutz und Informationsfreiheit"
AUFSICHT_STREET="Alt-Moabit 59–61"
AUFSICHT_POSTAL_CODE=10555
AUFSICHT_CITY=Berlin
AUFSICHT_PHONE="030 / 138 89-0"
AUFSICHT_EMAIL=mailbox@datenschutz-berlin.de
AUFSICHT_URL=https://www.datenschutz-berlin.de

# Auftragsverarbeiter (Hosting)
HOSTING_PROVIDER="Hetzner Online GmbH"
HOSTING_ADDRESS="Industriestr. 25, 91710 Gunzenhausen"
HOSTING_LOCATION=Deutschland
HOSTING_PRIVACY_URL=https://www.hetzner.com/de/legal/privacy-policy

# Auftragsverarbeiter (E-Mail)
EMAIL_PROVIDER="Verdigado eG"
EMAIL_PROVIDER_PRIVACY_URL=https://www.verdigado.com/datenschutz

# Sonstiges
DATENSCHUTZ_STAND="März 2026"
ACCOUNT_DELETION_DATE="31. Oktober 2026"

# Iframe-Embed (optional)
# Domain, die das Anmeldeformular per <iframe> einbinden darf
# ALLOWED_EMBED_DOMAIN=https://gruene-mitte.de

# Bezeichnung der Gebietseinheit (optional, Default: "Wahlkreis" / "Wahlkreise" / "WK")
# Mehrzahl ist standardmäßig Einzahl + "e", Kurzform standardmäßig die Einzahl.
# NEXT_PUBLIC_*-Werte werden beim Build eingebettet – nach Änderung neu bauen.
# NEXT_PUBLIC_WAHLKREIS_LABEL="Stadtbezirk"
# NEXT_PUBLIC_WAHLKREIS_LABEL_PLURAL="Stadtbezirke"
# NEXT_PUBLIC_WAHLKREIS_LABEL_SHORT="Stadtbezirk"
# "false", wenn die Gebiete keine Nummern tragen (z. B. Stadtbezirke mit Namen):
# Filter, Karten und Listen zeigen dann nur Namen, die Nummer bestimmt nur die Reihenfolge.
# NEXT_PUBLIC_WAHLKREIS_NUMMERN=false

# Wahlkreise (JSON-Array, optional)
# WAHLKREISE_JSON='[{"nummer":1,"name":"Wahlkreis 1"},{"nummer":2,"name":"Wahlkreis 2"}]'

# Cron-Jobs (Zeiten in UTC, Details in docs/deployment/coolify-deployment.md):
# Tagesübersicht an Ansprechpersonen (21 Uhr Sommerzeit; nicht nach 24:00 UTC):
#   0 19 * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/daily-summary
# Anmeldedaten 72 h nach Aktionsende und E-Mail-Logs nach 7 Tagen löschen (stündlich):
#   0 * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/cleanup-signups
# Erinnerung am Vorabend der Aktion (19 Uhr Sommerzeit):
#   0 17 * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" http://127.0.0.1:3000/api/cron/send-reminders
